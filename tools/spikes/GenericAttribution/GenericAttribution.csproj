<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../local.props" Condition="Exists('../../../local.props')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GameData Condition="'$(GameData)' == ''">$(GameDir)/data_sts2_windows_x86_64</GameData>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(GameData)/0Harmony.dll" />
    <Reference Include="System.Reflection.MetadataLoadContext" HintPath="$(MSBuildToolsPath)/System.Reflection.MetadataLoadContext.dll" />
  </ItemGroup>
</Project>
